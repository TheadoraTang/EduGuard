POSTGRES_DB=eduguard
POSTGRES_USER=eduguard
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=5173

# OpenAI-compatible API. Leave the key empty to use deterministic rule fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
BEHAVIOR_CLASSIFIER_MODE=ml
BEHAVIOR_CLASSIFIER_PATH=data/models/studychat_behavior_tfidf_logreg.joblib
BEHAVIOR_CLASSIFIER_MIN_CONFIDENCE=0.5
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=720

# Used by local backend runs; Docker Compose overrides this value.
DATABASE_URL=sqlite:///./eduguard.db
FRONTEND_ORIGIN=http://localhost:5173
STUDYCHAT_HASH_SALT=replace_with_a_private_random_salt
